<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Flarestack.Templates</PackageId>
    <Version>0.1.0-local.2</Version>
    <Authors>Flarestack contributors</Authors>
    <Description>Local Flarestack Blazor starter with Aspire, Better Auth and D1.</Description>
    <PackageType>Template</PackageType>
    <PackageTags>dotnet-new;templates;blazor;aspire</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/michielryvers/flarestack</PackageProjectUrl>
    <RepositoryUrl>https://github.com/michielryvers/flarestack.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoBuild>true</NoBuild>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../artifacts/template/content/**/*" Pack="true" PackagePath="content/" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>
  <Target Name="RequireStagedTemplate" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('../../artifacts/template/content/.template.config/template.json')" Text="Run bun run prepare:local to stage and pack the template." />
  </Target>
</Project>
