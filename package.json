{
  "name": "flarestack",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test ./spikes/compatibility ./src/alchemy ./scripts/local-mode.test.ts ./scripts/release-policy.test.ts ./scripts/cloud-acceptance.test.ts ./scripts/package-process.test.ts ./scripts/acceptance-diagnostics.test.ts ./scripts/e2e-process.test.ts",
    "verify:telemetry": "bun tests/e2e/verify-telemetry.ts",
    "dev": "aspire run",
    "test:e2e": "playwright test",
    "build:auth-ui": "bun build src/Flarestack.Authentication/browser/sign-in.ts --target browser --minify --outfile src/Flarestack.Authentication/wwwroot/sign-in.js",
    "dev:container": "bun scripts/local-mode.ts container",
    "dev:standalone": "bun samples/Todo/infra/node_modules/@flarestack/alchemy/local/dev.ts samples/Todo/local.json",
    "test:e2e:container": "bun scripts/local-mode.ts e2e-container",
    "test:hot-reload": "bun scripts/local-mode.ts hot-reload",
    "prepare:local": "bun scripts/prepare-local.ts",
    "test:template": "bun test ./scripts/template.test.ts",
    "configure:local": "bun samples/Todo/infra/node_modules/@flarestack/alchemy/local/configure.ts samples/Todo/local.json",
    "doctor": "bun samples/Todo/infra/node_modules/@flarestack/alchemy/local/doctor.ts samples/Todo/local.json",
    "test:acceptance": "bun scripts/accept-template.ts",
    "check:versions": "bun scripts/check-versions.ts",
    "smoke:cloud": "bun scripts/smoke-cloud.ts",
    "plan:cloud": "bun scripts/deploy-cloud.ts plan",
    "deploy:cloud": "bun scripts/deploy-cloud.ts deploy",
    "destroy:cloud": "bun scripts/deploy-cloud.ts destroy",
    "tunnel": "bun scripts/tunnel.ts",
    "test:cloud": "bun scripts/accept-cloud.ts",
    "migrate:local-state": "bun samples/Todo/infra/node_modules/@flarestack/alchemy/local/migrate-state.ts samples/Todo/local.json"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.79",
    "@better-auth/oauth-provider": "1.7.5",
    "@cloudflare/containers": "0.3.7",
    "@effect/platform-bun": "4.0.0-rc.116",
    "@effect/platform-node": "4.0.0-rc.116",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "alchemy": "2.0.0-beta.79",
    "better-auth": "1.7.5",
    "better-call": "1.4.0",
    "effect": "4.0.0-rc.116"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.79": "patches/alchemy@2.0.0-beta.79.patch",
    "@alchemy.run/cloudflare-runtime@2.0.0-beta.79": "patches/cloudflare-runtime@2.0.0-beta.79.patch"
  }
}
