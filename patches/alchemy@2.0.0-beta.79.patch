diff --git a/src/Cloudflare/LocalCredentials.ts b/src/Cloudflare/LocalCredentials.ts
new file mode 100644
index 0000000000000000000000000000000000000000..006f0d1d0e4bc0134a97d81b3b82537971f2b46c
--- /dev/null
+++ b/src/Cloudflare/LocalCredentials.ts
@@ -0,0 +1,20 @@
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Redacted from "effect/Redacted";
+import { CloudflareEnvironment } from "./CloudflareEnvironment.ts";
+import { Credentials } from "./Credentials.ts";
+
+// Flarestack local Worker bindings and D1 gateways need an account namespace,
+// not cloud authorization. Never read a real profile or authorize remote APIs.
+// The local sidecar and stack evaluation must use the same namespace.
+export const localCredentials = () => Layer.mergeAll(
+  Layer.succeed(CloudflareEnvironment, Effect.succeed({
+    type: "apiToken" as const,
+    accountId: "00000000000000000000000000000000",
+    apiToken: Redacted.make(""),
+    source: { type: "env" as const },
+  })),
+  Layer.succeed(Credentials, Effect.die(new Error(
+    "Cloudflare API access is unavailable in Flarestack local development; use an authenticated cloud deployment for remote resources.",
+  ))),
+);
